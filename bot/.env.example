# Copy this file to .env and fill it in.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# The mod's REST API. The bot runs on the same machine as the server, so localhost.
API_URL=http://127.0.0.1:8080
# BearerToken from rsdwapi/settings.ini
API_TOKEN=

# Shown in /status, /help and server notices
SERVER_NAME=Dragonwilds Server

# Shown as "3/16 players". Match your server's MaxPlayers. 0 hides it.
MAX_PLAYERS=0

# How often to check the server and snapshot player stats, in seconds (minimum 10).
POLL_SECONDS=30

# Comma separated channel IDs the slash commands work in. Empty allows every channel.
ALLOWED_CHANNELS=

# --- Chat ---------------------------------------------------------------
# (Discord: Settings -> Advanced -> Developer Mode, then right-click a channel -> Copy Channel ID)

# In-game chat is posted here, and messages typed here are sent into the game.
# Leave empty to turn chat off both ways.
CHAT_CHANNEL_ID=
# Player deaths go here. Empty uses CHAT_CHANNEL_ID.
DEATH_CHANNEL_ID=
# How often to check for new chat and deaths, in seconds.
RELAY_SECONDS=3

# Send messages from CHAT_CHANNEL_ID into the game. false makes it one way (game -> Discord).
BRIDGE_TO_GAME=true
# Only members with this role can talk into the game. Empty lets everyone.
BRIDGE_ROLE_ID=
# Players see "[Discord] Name: message".
BRIDGE_PREFIX=Discord
# Longer Discord messages are cut to this many characters in game.
BRIDGE_MAX_LENGTH=200

# --- Server notices -----------------------------------------------------

# Online / offline / restarting notices, plus restarts and backups announced by
# scripts (src/announce.js), go here. Empty uses CHAT_CHANNEL_ID.
STATUS_CHANNEL_ID=
SERVER_NOTICES=true
# false keeps the hourly "Backup complete" notices out of Discord (backups still run).
BACKUP_NOTICES=true

# --- Player activity ----------------------------------------------------

# "🎉 Name reached Woodcutting 43" in LEVELUP_CHANNEL_ID (empty: the chat channel).
# Levels below LEVELUP_MIN_LEVEL are quiet - the first ones come very fast. 99s are always announced.
LEVELUP_NOTICES=true
LEVELUP_MIN_LEVEL=10
LEVELUP_CHANNEL_ID=
# "➡️ Name joined · 3/16 online" and "⬅️ Name left after 1h 20m" in the chat channel.
JOIN_LEAVE_NOTICES=true
# Sundays at 20:00 (VPS time): top XP gainers, new 99s, most played, deaths.
WEEKLY_SUMMARY=true
SUMMARY_CHANNEL_ID=

# --- Admin --------------------------------------------------------------

# Discord user IDs (comma separated) allowed to use /server and /admin. Empty means nobody.
# (Developer Mode on, then right-click your name -> Copy User ID)
ADMIN_USER_IDS=
# The game server's systemd service, for /server start / stop / restart.
SERVER_SERVICE=dragonwilds
# What /server backup runs.
BACKUP_SCRIPT=/home/dragonwilds/scripts/backup.sh
# Private messages to the admins: unplanned crashes, the mod's self-check failing
# (usually after a game update), and the VPS running hot. 0 turns one limit off.
ADMIN_ALERTS=true
ALERT_CPU=90
ALERT_RAM=90
ALERT_DISK=90

# --- Misc ---------------------------------------------------------------

# Where player snapshots, the relay position and bot.log are kept. Defaults to bot/data.
DATA_DIR=

# true logs reaction presses, presence updates, relay batches and undelivered chat as well.
DEBUG=false
